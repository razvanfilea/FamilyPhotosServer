  "query": "select id as \"id!\", user_id as \"user_id?\", name as \"name!\", created_at as \"created_at!: OffsetDateTime\", file_size as \"file_size!\", folder_id as \"folder_id?\", thumb_hash as \"thumb_hash?\", trashed_on as \"trashed_on?: OffsetDateTime\"\n            from photos where user_id is null\n            union all\n            select id, user_id, name, created_at, file_size, folder_id, thumb_hash, trashed_on\n            from photos where user_id = $1\n            order by created_at desc, id",
