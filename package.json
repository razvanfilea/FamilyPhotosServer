{
  "name": "familyphotos",
  "scripts": {
    "dev": "npx @tailwindcss/cli -i templates/input.css -o assets/css/main.css --watch",
    "prod": "npx @tailwindcss/cli -i templates/input.css -o assets/css/main.css --minify",
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium",
    "test": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test --config playwright/playwright.config.ts",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test --config playwright/playwright.config.ts --ui"
  },
  "devDependencies": {
    "daisyui": "5.8.0",
    "@tailwindcss/cli": "4.3.5",
    "@playwright/test": "1.65.1"
  }
}
